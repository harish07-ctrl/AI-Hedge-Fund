# LLM Provider (gemini | openai | groq)
LLM_PROVIDER=gemini

# Google Gemini (default - free tier)
GOOGLE_API_KEY=your_google_api_key_here

# OpenAI (optional)
OPENAI_API_KEY=your_openai_api_key_here

# Groq (optional - free tier)
GROQ_API_KEY=your_groq_api_key_here

# Financial Data APIs (free tiers)
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_key_here
FINNHUB_API_KEY=your_finnhub_key_here

# Tavily Search (free tier - 1000 calls/month)
TAVILY_API_KEY=your_tavily_api_key_here

# LangSmith (optional - free tier)
LANGSMITH_ENABLED=false
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGCHAIN_PROJECT=ai-hedge-fund

# SEC EDGAR (free - just needs a user agent email)
SEC_EDGAR_USER_AGENT=your_email@example.com

# App Settings
DATABASE_URL=sqlite+aiosqlite:///./hedge_fund.db
CORS_ORIGINS=http://localhost:3000,http://localhost:8000
