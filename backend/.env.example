# LLM Provider (gemini | openai | groq)
LLM_PROVIDER=gemini

# Google Gemini API Key (Free tier - get from https://aistudio.google.com/apikey)
GOOGLE_API_KEY=your_gemini_api_key_here

# Optional LLM providers
OPENAI_API_KEY=
GROQ_API_KEY=

# Financial Data APIs (Alpha Vantage & Finnhub)
ALPHA_VANTAGE_API_KEY=3UBQXK6GXB2LD2PA
FINNHUB_API_KEY=dab7aqhr01qlf7h0ral0dab7aqhr01qlf7h0ralg

# News Search API (Tavily free tier)
TAVILY_API_KEY=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

# SEC EDGAR (free - user agent header required by SEC)
