# LLM Provider (gemini | openai | groq)
LLM_PROVIDER=gemini

# Google Gemini API Key (Free tier available)
GOOGLE_API_KEY=your_free_gemini_api_key

# Optional LLM providers
OPENAI_API_KEY=
GROQ_API_KEY=

# Free Financial Data APIs
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_key
FINNHUB_API_KEY=your_finnhub_key

# Free News Search API (Tavily free tier / DuckDuckGo fallback)
TAVILY_API_KEY=your_tavily_key

# SEC EDGAR (free - user agent header required by SEC)
SEC_EDGAR_USER_AGENT=research@example.com

# Hackathon Demo / Cache Settings
DEMO_MODE=false
CACHE_TTL_SECONDS=1800

# LangSmith Tracing (optional)
LANGSMITH_ENABLED=false
LANGSMITH_API_KEY=
LANGCHAIN_PROJECT=ai-hedge-fund

# Local Database
DATABASE_URL=sqlite+aiosqlite:///./hedge_fund.db
CORS_ORIGINS=http://localhost:3000,http://localhost:8000
